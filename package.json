{
  "name": "fanatic-museum",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "dependencies": {
    "@fontsource-variable/noto-sans-kr": "^5.3.1",
    "@sentry/react-router": "^11.11.0",
    "isbot": "^5",
    "react": "^19.3.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "web-vitals": "^6.2.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@feature-sliced/steiger-plugin": "^0.8.2",
    "@lhci/cli": "^0.16.0",
    "@playwright/test": "^1.65.0",
    "@react-router/dev": "^8.5.1",
    "@size-limit/file": "^14.3.0",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-vitest": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/browser-playwright": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "sirv-cli": "^3.0.1",
    "size-limit": "^14.3.0",
    "steiger": "^0.10.0",
    "storybook": "^10.6.7",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build && node scripts/prune-assets.mjs && node scripts/sitemap.mjs",
    "preview": "sirv build/client --port 4173 --single __spa-fallback.html",
    "typecheck": "react-router typegen && tsc",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "api:types": "openapi-typescript openapi/archive.yaml -o src/shared/api/schema.d.ts",
    "media:download": "node scripts/media/download.mjs",
    "media:build": "node scripts/media/build-variants.mjs",
    "size": "size-limit",
    "lhci": "lhci autorun",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o build/client/storybook",
    "build:all": "pnpm build && pnpm build-storybook",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api:check": "pnpm api:types && git diff --exit-code src/shared/api/schema.d.ts",
    "lint:fsd": "steiger src",
    "screenshots": "node scripts/screenshots.mjs",
    "media:agent": "zsh scripts/media/launch-agent.sh"
  }
}
